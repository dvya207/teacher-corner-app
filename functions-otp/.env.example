# Numbers here get the OTP written to the function log and the SMS SKIPPED.
# Full normalized form, comma separated, exactly as normalizePhone produces:
#   TEST_PHONES=+919999999999,+918888888888
#
# LEAVING THIS EMPTY MEANS EVERY NUMBER GETS A REAL SMS, billed to the
# production ThinkTac Exotel account and sent from sender TACTIN to a real
# handset. There is no Exotel sandbox. Put your own number here before the
# first deploy.
TEST_PHONES=

# Exotel account / DLT registration ids. Not credentials, but they identify the
# organisation's telecom account, so they are not committed. Get them from the
# Exotel console and the DLT registry entry for your sender.
EXOTEL_ACCOUNT_SID=
EXOTEL_ENTITY_ID=
EXOTEL_SENDER=
OTP_TEMPLATE_ID=
